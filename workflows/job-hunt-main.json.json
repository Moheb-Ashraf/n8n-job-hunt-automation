        "jsCode": "return $input.all().map(item => {\n  const text = (item.json.description || '')\n    .replace(/<[^>]*>/g, ' ')   // يشيل أي HTML tags\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/\\s+/g, ' ')       // يوحّد المسافات\n    .trim()\n    .slice(0, 1500);            // أول 1500 حرف بس\n\n  return { json: { ...item.json, description: text } };\n});"
      },
